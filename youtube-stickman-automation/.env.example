# Copy to .env and fill in. Never commit the real .env file.

# --- Stage 1,2,5,6,10 (text/reasoning) ---
# Default provider is Claude Code headless mode — no key needed.
# Set LLM_PROVIDER=openai to use ChatGPT instead (needs its own API billing,
# separate from a ChatGPT Pro chat subscription).
LLM_PROVIDER=claude_code
OPENAI_API_KEY=

# --- Stage 3: ElevenLabs voice generation ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stage 4: transcription ---
# TRANSCRIPTION_PROVIDER=fozi_scribe | whisper_local
TRANSCRIPTION_PROVIDER=whisper_local
FOZISCRIBE_API_KEY=

# --- Stage 6-7: image generation ---
# IMAGE_GEN_PROVIDER=openai -> calls the OpenAI Images API (needs its own
#   billing, separate from ChatGPT Pro's chat subscription — set
#   IMAGE_GEN_API_KEY below).
# IMAGE_GEN_PROVIDER=gemini -> calls Google's Gemini API — get a key at
#   aistudio.google.com. This is the same Imagen model family behind
#   Google Flow, just through an automatable route instead of Flow's
#   browser-only UI. NOTE: image-output models have been observed with a
#   hard zero free-tier quota (429 "limit: 0") — in practice this needs
#   billing enabled on the Google Cloud project behind the key, same as
#   OpenAI's image_gen_provider. Gemini's free tier covers text generation
#   generously; image generation is the exception.
#   Set GEMINI_API_KEY below.
# IMAGE_GEN_PROVIDER=manual -> no API key needed at all. Stage 7 pauses
#   (the "image_upload" gate) and shows you each scene's prompt to
#   generate yourself (e.g. paste into ChatGPT, which IS covered by a Pro
#   subscription) and upload the result — automatic in the UI, or drop
#   files into data/projects/<id>/07_images/<scene_id>/image.png by hand
#   when using the CLI.
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_API_KEY=
GEMINI_API_KEY=
# Google renames/deprecates image-gen model IDs fairly often. If Stage 7
# fails with "Gemini model '...' not found", list your available models at
# https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY (or
# see https://ai.google.dev/gemini-api/docs/image-generation) and set the
# current one here — no code change needed.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Stage 9: Canva Connect (Autofill + Export API) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=

# --- Stage 10: YouTube Data API v3 ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
